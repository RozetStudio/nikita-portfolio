---
import SectionBadge from "./SectionBadge.astro";

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  headingId: string;
  align?: "center" | "left";
}

const { eyebrow, title, subtitle, headingId, align = "center" } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-4",
    align === "center" ? "items-center text-center" : "items-start text-left",
  ]}
  data-reveal
>
  <SectionBadge label={eyebrow} />
  <h2
    id={headingId}
    class="max-w-[760px] text-[clamp(2rem,4.6vw,4rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-balance"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="max-w-[620px] text-[15px] leading-relaxed text-fg-muted sm:text-base">{subtitle}</p>
  )}
</div>
