---
import { BASE_PATH, NAV_LINKS, SITE_NAME, withBase } from "@/config/site";
import StarMark from "../ui/StarMark.astro";

// На внутренних страницах якоря должны вести на главную с учётом base:
// на GitHub Pages это /<repo>/#services, локально — /#services.
const pathname = Astro.url.pathname;
const isHome =
  pathname === "/" || pathname === BASE_PATH || pathname === BASE_PATH.replace(/\/$/, "");
const homeHref = (hash: string) => (isHome ? hash : `${BASE_PATH}${hash}`);
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-[72px] w-full max-w-[1152px] items-center justify-between gap-6 px-5 sm:px-8">
    <a
      href={isHome ? "#top" : BASE_PATH}
      class="flex items-center gap-2.5"
      aria-label="Никита — на главную"
    >
      <span class="flex h-8 w-8 items-center justify-center rounded-[10px] border border-line bg-white/[0.04]">
        <StarMark class="h-4 w-4 text-fg" />
      </span>
      <span class="text-[15px] font-semibold tracking-tight">{SITE_NAME}</span>
    </a>

    <nav aria-label="Основная навигация" class="hidden items-center gap-8 md:flex">
      {NAV_LINKS.map((link) => (
        <a
          data-nav
          href={homeHref(link.href)}
          class="inline-flex min-h-6 items-center text-sm text-fg-muted transition duration-200 hover:text-fg aria-[current=true]:text-fg"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a href={homeHref("#contact")} class="btn btn-primary btn-sm">
        Связаться
      </a>
    </div>

    <!-- Бургер: две линии, морфятся в крестик при открытии меню -->
    <button
      type="button"
      data-menu-open
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Открыть меню"
      class="relative flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/[0.03] text-fg transition hover:border-line-strong md:hidden"
    >
      <span aria-hidden="true" class="burger-line"></span>
      <span aria-hidden="true" class="burger-line"></span>
    </button>
  </div>
</header>

<!-- Мобильное меню на нативном dialog: Esc и focus-trap из коробки -->
<dialog
  data-mobile-menu
  id="mobile-menu"
  aria-label="Меню"
  class="m-0 h-dvh max-h-none w-full max-w-full border-0 bg-bg p-0"
>
  <div class="flex h-full flex-col" data-menu-panel>
    <div class="flex h-[72px] items-center justify-between border-b border-line px-5 sm:px-8">
      <span class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-[10px] border border-line bg-white/[0.04]">
          <StarMark class="h-4 w-4 text-fg" />
        </span>
        <span class="text-[15px] font-semibold tracking-tight">{SITE_NAME}</span>
      </span>
      <button
        type="button"
        data-menu-close
        aria-label="Закрыть меню"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/[0.03] text-fg transition hover:border-line-strong"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav
      aria-label="Мобильная навигация"
      class="flex flex-1 flex-col items-start justify-center gap-2 px-5"
    >
      {NAV_LINKS.map((link) => (
        <a
          href={homeHref(link.href)}
          data-menu-item
          class="w-full rounded-2xl px-4 py-4 text-2xl font-semibold tracking-[-0.02em] text-fg-muted transition hover:bg-white/[0.04] hover:text-fg"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="px-5 pb-10" data-menu-item>
      <a href={homeHref("#contact")} class="btn btn-primary w-full">
        Связаться
      </a>
      <a
        href={withBase("terms/")}
        data-menu-item
        class="mt-3 flex min-h-11 w-full items-center justify-center rounded-full border border-line bg-white/[0.03] px-4 text-sm font-medium text-fg-muted transition duration-200 hover:border-line-strong hover:text-fg"
      >
        Пользовательское соглашение
      </a>
    </div>
  </div>
</dialog>

<style>
  /* Блокировка фона при открытом меню. Нужна и без Lenis:
     при prefers-reduced-motion он не инициализируется. */
  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }

  [data-header] {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  [data-header].is-scrolled {
    background: rgba(7, 7, 7, 0.72);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom-color: var(--color-line);
  }

  dialog[data-mobile-menu] {
    border: none;
    outline: none;
    /* Плавное появление/исчезновение меню */
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.32s var(--ease-out-expo),
      transform 0.32s var(--ease-out-expo);
    pointer-events: none;
  }
  dialog[data-mobile-menu].is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  dialog[data-mobile-menu]::backdrop {
    background: rgba(3, 3, 3, 0.7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    /* Backdrop живёт в top layer до dialog.close(): гасим его сразу
       при закрытии, чтобы блюр не «залипал» на время анимации панели */
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  dialog[data-mobile-menu].is-open::backdrop {
    opacity: 1;
  }

  /* Каскадное появление пунктов */
  [data-menu-item] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }
  dialog[data-mobile-menu].is-open [data-menu-item] {
    opacity: 1;
    transform: translateY(0);
  }
  dialog[data-mobile-menu].is-open nav a:nth-child(1) {
    transition-delay: 0.06s;
  }
  dialog[data-mobile-menu].is-open nav a:nth-child(2) {
    transition-delay: 0.12s;
  }
  dialog[data-mobile-menu].is-open nav a:nth-child(3) {
    transition-delay: 0.18s;
  }
  dialog[data-mobile-menu].is-open [data-menu-item]:last-of-type {
    transition-delay: 0.22s;
  }

  /* Бургер-морф: анимируется только transform — плавно, на композиторе */
  [data-menu-open] .burger-line {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 0.32s var(--ease-out-expo),
      opacity 0.2s linear;
  }
  [data-menu-open] .burger-line:first-child {
    top: 15px;
  }
  [data-menu-open] .burger-line:last-child {
    top: 23px;
  }
  [data-menu-open][aria-expanded="true"] .burger-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  [data-menu-open][aria-expanded="true"] .burger-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
</style>

<script>
  import { initHeader } from "@/scripts/header";

  initHeader();
</script>
