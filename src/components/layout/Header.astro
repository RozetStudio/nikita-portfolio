---
import { NAV_LINKS, SITE_NAME } from "@/config/site";
import StarMark from "../ui/StarMark.astro";
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-[72px] w-full max-w-[1152px] items-center justify-between gap-6 px-5 sm:px-8">
    <a href="#top" class="flex items-center gap-2.5" aria-label="Никита — на главную">
      <span class="flex h-8 w-8 items-center justify-center rounded-[10px] border border-line bg-white/[0.04]">
        <StarMark class="h-4 w-4 text-fg" />
      </span>
      <span class="text-[15px] font-semibold tracking-tight">{SITE_NAME}</span>
    </a>

    <nav aria-label="Основная навигация" class="hidden items-center gap-8 md:flex">
      {NAV_LINKS.map((link) => (
        <a
          data-nav
          href={link.href}
          class="text-sm text-fg-muted transition duration-200 hover:text-fg aria-[current=true]:text-fg"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a href="#contact" class="btn btn-primary btn-sm">
        Связаться
      </a>
    </div>

    <button
      type="button"
      data-menu-open
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Открыть меню"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/[0.03] text-fg transition hover:border-line-strong md:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h10"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Мобильное меню на нативном dialog: Esc и focus-trap из коробки -->
<dialog
  data-mobile-menu
  id="mobile-menu"
  aria-label="Меню"
  class="m-0 h-dvh max-h-none w-full max-w-full border-0 bg-bg p-0"
>
  <div class="flex h-full flex-col">
    <div class="flex h-[72px] items-center justify-between border-b border-line px-5 sm:px-8">
      <span class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-[10px] border border-line bg-white/[0.04]">
          <StarMark class="h-4 w-4 text-fg" />
        </span>
        <span class="text-[15px] font-semibold tracking-tight">{SITE_NAME}</span>
      </span>
      <button
        type="button"
        data-menu-close
        aria-label="Закрыть меню"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/[0.03] text-fg transition hover:border-line-strong"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav
      aria-label="Мобильная навигация"
      class="flex flex-1 flex-col items-start justify-center gap-2 px-5"
    >
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="w-full rounded-2xl px-4 py-4 text-2xl font-semibold tracking-[-0.02em] text-fg-muted transition hover:bg-white/[0.04] hover:text-fg"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="px-5 pb-10">
      <a href="#contact" class="btn btn-primary w-full">
        Связаться
      </a>
    </div>
  </div>
</dialog>

<style>
  [data-header] {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  [data-header].is-scrolled {
    background: rgba(7, 7, 7, 0.72);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom-color: var(--color-line);
  }

  dialog[data-mobile-menu] {
    border: none;
    outline: none;
  }
  dialog[data-mobile-menu]::backdrop {
    background: rgba(3, 3, 3, 0.7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
</style>

<script>
  import { initHeader } from "@/scripts/header";

  initHeader();

  // Кнопка закрытия внутри диалога
  const dialog = document.querySelector<HTMLDialogElement>("[data-mobile-menu]");
  dialog?.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog.close());
</script>
