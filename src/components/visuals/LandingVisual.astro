---
// Мини-визуал: окно браузера с лендингом (декоративное)
---

<div aria-hidden="true" class="mt-auto pt-6">
  <div class="rounded-tile border border-line bg-bg-deep/70 p-3 transition duration-300 group-hover:border-line-strong">
    <div class="flex items-center gap-1.5 pb-2.5">
      <span class="h-1.5 w-1.5 rounded-full bg-white/25"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-white/15"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-white/10"></span>
      <span class="ml-2 h-1.5 flex-1 rounded-full bg-white/[0.07]"></span>
    </div>
    <div class="space-y-2">
      <div class="h-1.5 w-2/5 rounded-full bg-white/25"></div>
      <div class="h-1.5 w-3/5 rounded-full bg-white/10"></div>
      <div class="grid grid-cols-3 gap-2 pt-1">
        <span class="h-9 rounded-md border border-line bg-white/[0.04]"></span>
        <span class="h-9 rounded-md border border-line bg-white/[0.04]"></span>
        <span class="h-9 rounded-md border border-line bg-white/[0.02]"></span>
      </div>
    </div>
  </div>
</div>
