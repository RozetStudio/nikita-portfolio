    <span class="h-12 rounded-md border border-dashed border-white/15"></span>
    <span class="h-12 rounded-md border border-white/25 bg-white/[0.06]"></span>
    <span class="h-12 rounded-md border border-white/10 bg-white/[0.02]"></span>
  </div>
</div>
