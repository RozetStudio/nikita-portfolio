---

<div aria-hidden="true" class="mt-auto pt-6">
  <div class="flex flex-col gap-2 rounded-tile border border-line bg-bg-deep/70 p-3 transition duration-300 group-hover:border-line-strong">
    <div class="h-6 w-4/5 self-start rounded-2xl rounded-bl-md bg-white/[0.09]"></div>
    <div class="h-6 w-3/5 self-start rounded-2xl rounded-bl-md bg-white/[0.09]"></div>
    <div class="h-6 w-2/3 self-end rounded-2xl rounded-br-md bg-white/[0.22]"></div>
    <div class="mt-1 flex items-center gap-2 rounded-full border border-line bg-white/[0.03] px-2.5 py-1.5">
      <span class="h-1.5 flex-1 rounded-full bg-white/[0.08]"></span>
      <span class="h-3 w-3 rounded-full bg-white/40"></span>
    </div>
  </div>
</div>
