---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SectionBadge from "../components/ui/SectionBadge.astro";
import { SITE_NAME, TELEGRAM_URL, VK_URL, isPlaceholder } from "@/config/site";

const legalVersion = "1.0";
const legalDate = "26 ноября 2026 г.";

const telegramStub = isPlaceholder(TELEGRAM_URL);
const vkStub = isPlaceholder(VK_URL);

const toc = [
  { id: "general", title: "1. Общие положения" },
  { id: "terms", title: "2. Термины" },
  { id: "subject", title: "3. Предмет соглашения" },
  { id: "order", title: "4. Порядок оформления заказа" },
  { id: "price", title: "5. Стоимость и оплата" },
  { id: "timing", title: "6. Сроки и рабочее время" },
  { id: "demo", title: "7. Демо-версия" },
  { id: "acceptance", title: "8. Приёмка работы" },
  { id: "revisions", title: "9. Правки и дополнительные работы" },
  { id: "refund", title: "10. Отказ от работы и возврат" },
  { id: "rights", title: "11. Права на результат" },
  { id: "warranty", title: "12. Гарантии и ответственность" },
  { id: "privacy", title: "13. Конфиденциальность и персональные данные" },
  { id: "content", title: "14. Материалы заказчика и запрещённый контент" },
  { id: "force-majeure", title: "15. Обстоятельства непреодолимой силы" },
  { id: "disputes", title: "16. Разрешение споров" },
  { id: "changes", title: "17. Изменение соглашения" },
  { id: "contacts", title: "18. Реквизиты и контакты" },
];

const description =
  "Условия работы, оплаты, приёмки и возврата: 50% предоплата, этапы работы, права на результат, конфиденциальность и контакты.";
---

<BaseLayout title="Пользовательское соглашение — Никита" description={description}>
  <Header />
  <main id="main" class="relative pb-20 pt-[104px] sm:pb-28 sm:pt-[128px]">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-0 h-[380px] w-[720px] max-w-full -translate-x-1/2 rounded-full bg-white/[0.03] blur-[120px]"
    ></div>

    <div class="container-page relative">
      <div class="mx-auto max-w-[1080px]">
        <a
          href="/"
          data-print-hide
          class="inline-flex items-center gap-2 text-sm text-fg-dim transition duration-200 hover:text-fg-muted"
        >
          <span aria-hidden="true">←</span>
          На главную
        </a>

        <div class="mt-6 flex flex-col items-start gap-4 border-b border-line pb-8" data-print-hide>
          <SectionBadge label="Документы" />
          <h1
            id="legal-title"
            class="max-w-[860px] text-[clamp(2rem,4.6vw,4rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-balance"
          >
            Пользовательское соглашение
          </h1>
          <p class="max-w-[720px] text-[15px] leading-relaxed text-fg-muted sm:text-base">
            Условия работы, оплаты, приёмки и возврата. Документ действует для всех услуг,
            оказываемых через этот сайт.
          </p>
          <p class="text-xs text-fg-dim">
            Редакция {legalVersion} от {legalDate}
          </p>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-14">
          <aside class="lg:sticky lg:top-24 lg:self-start" data-print-hide>
            <details class="card p-4 lg:hidden">
              <summary class="cursor-pointer text-sm font-semibold text-fg">Содержание</summary>
              <ol class="mt-4 space-y-2 text-sm">
                {toc.map((item) => (
                  <li>
                    <a
                      href={`#${item.id}`}
                      class="text-fg-muted transition duration-200 hover:text-fg"
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ol>
            </details>

            <nav aria-label="Содержание документа" class="card hidden p-5 lg:block">
              <p class="eyebrow">Содержание</p>
              <ol class="mt-4 space-y-2 text-sm">
                {toc.map((item) => (
                  <li>
                    <a
                      href={`#${item.id}`}
                      class="block text-fg-muted transition duration-200 hover:text-fg"
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>

          <article class="min-w-0 space-y-10 text-[15px] leading-7 text-fg-muted print:text-black">
            <section
              id="general"
              aria-labelledby="general-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="general-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                1. Общие положения
              </h2>
              <p>
                Настоящее Пользовательское соглашение (далее — Соглашение) определяет условия
                использования сайта и оказания услуг. Исполнитель — {SITE_NAME}, применяющий
                специальный налоговый режим «Налог на профессиональный доход» (самозанятый).
              </p>
              <p>
                Заказчик — дееспособное физическое лицо, достигшее 18 лет, индивидуальный
                предприниматель или юридическое лицо, обратившееся к Исполнителю за услугами.
                Используя сайт, направляя заявку, согласовывая ТЗ и смету, оплачивая счёт или
                предоплату, Заказчик принимает условия Соглашения (акцепт).
              </p>
              <p>
                Соглашение является публичной офертой в части общих условий оказания услуг.
                Конкретный объём работ, стоимость, сроки и критерии приёмки фиксируются в
                техническом задании (ТЗ) и смете, которые согласуются сторонами отдельно.
              </p>
              <p>
                К отношениям сторон применяется законодательство Российской Федерации, в том числе
                Гражданский кодекс РФ, Закон РФ «О защите прав потребителей» (для
                Заказчиков-потребителей) и Федеральный закон № 152-ФЗ «О персональных данных».
                Переписка в Telegram, VK и по электронной почте имеет юридическую силу и может
                использоваться как доказательство согласования условий.
              </p>
              <p>
                Если Заказчик не согласен с Соглашением, он должен прекратить использование сайта и
                услуг. Соглашение действует бессрочно до замены новой редакцией.
              </p>
            </section>

            <section
              id="terms"
              aria-labelledby="terms-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="terms-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                2. Термины
              </h2>
              <ul class="list-disc space-y-2 pl-5 marker:text-fg-dim">
                <li>
                  <strong class="font-semibold text-fg">Сайт</strong> — интернет-страница, на
                  которой размещены информация об услугах и настоящее Соглашение.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Услуги</strong> — разработка лендингов,
                  Telegram-ботов, вёрстка, скрипты, автоматизация и связанные работы.
                </li>
                <li>
                  <strong class="font-semibold text-fg">ТЗ</strong> — согласованное сторонами
                  техническое задание: объём, функциональность, дизайн, сроки и критерии приёмки.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Смета</strong> — документ или сообщение с
                  ценой, этапами, сроками и условиями оплаты.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Демо</strong> — ограниченная версия
                  результата с водяным знаком для ознакомления.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Результат</strong> — созданные по ТЗ
                  материалы: код, дизайн, тексты, бот, доступы и иные объекты.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Приёмка</strong> — проверка Результата
                  Заказчиком на соответствие ТЗ.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Рабочие дни</strong> — понедельник–пятница,
                  кроме нерабочих праздничных дней. Рабочее время — 10:00–20:00 МСК.
                </li>
                <li>
                  <strong class="font-semibold text-fg">Стороны</strong> — Исполнитель и Заказчик.
                </li>
              </ul>
            </section>

            <section
              id="subject"
              aria-labelledby="subject-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="subject-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                3. Предмет соглашения
              </h2>
              <p>
                Исполнитель оказывает услуги по разработке лендингов, Telegram-ботов, вёрстке
                сайтов, скриптов и автоматизации, а также сопутствующие услуги по согласованию
                сторон. Конкретный перечень, функциональность, дизайн, сроки, стоимость и критерии
                приёмки определяются ТЗ и сметой.
              </p>
              <p>
                Информация на сайте носит ознакомительный характер и не является обещанием
                конкретного результата до согласования ТЗ. Исполнитель вправе привлекать третьих
                лиц, оставаясь ответственным за Результат перед Заказчиком.
              </p>
              <p>
                Исполнитель вправе отказаться от заказа, если задача противоречит закону, требует
                незаконных действий, недостоверных данных или сроки объективно невыполнимы.
              </p>
            </section>

            <section
              id="order"
              aria-labelledby="order-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="order-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                4. Порядок оформления заказа
              </h2>
              <ol class="list-decimal space-y-2 pl-5 marker:text-fg-dim">
                <li>Заказчик пишет в Telegram или VK и коротко описывает задачу.</li>
                <li>Стороны обсуждают цель, объём, сроки, бюджет и ограничения.</li>
                <li>Исполнитель готовит план и ТЗ. Если ТЗ нет, помогает его собрать.</li>
                <li>
                  Исполнитель направляет смету: цена, этапы, сроки, число правок и размер
                  предоплаты.
                </li>
                <li>Заказчик вносит 50% предоплату либо согласовывает бесплатную демо-версию.</li>
                <li>Исполнитель выполняет работу и показывает демо или тестовый доступ.</li>
                <li>Заказчик принимает работу по ТЗ, оплачивает остаток и получает Результат.</li>
              </ol>
              <p>
                Изменения ТЗ согласуются письменно. Задачи, не входящие в ТЗ, оформляются отдельной
                сметой. Заказчик предоставляет материалы, доступы и обратную связь в согласованные
                сроки; иначе сроки работы сдвигаются.
              </p>
            </section>

            <section
              id="price"
              aria-labelledby="price-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="price-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                5. Стоимость и оплата
              </h2>
              <p>
                Стоимость услуг указывается в рублях РФ и фиксируется в смете. Если объём работ
                меняется, стороны согласуют новую смету. Цена не меняется в одностороннем порядке
                после начала работы.
              </p>
              <p>
                Порядок оплаты: 50% предоплата перед началом работы, остальные 50% — после приёмки,
                до передачи исходного кода, доступов и исключительных прав. Оплата производится
                способом, согласованным сторонами. Комиссии банков и платёжных систем оплачиваются
                по правилам этих систем.
              </p>
              <p>
                Исполнитель применяет специальный налоговый режим «Налог на профессиональный доход».
                Чек формируется в приложении «Мой налог» и направляется Заказчику. НДС не облагается
                в связи с применением специального налогового режима. Каждая сторона самостоятельно
                уплачивает свои налоги и сборы.
              </p>
              <p>
                При просрочке оплаты Исполнитель вправе приостановить работу, а сроки сдвигаются
                пропорционально задержке. Уже выполненная работа оплачивается в согласованном
                объёме.
              </p>
            </section>

            <section
              id="timing"
              aria-labelledby="timing-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="timing-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                6. Сроки и рабочее время
              </h2>
              <p>
                Сроки указываются в ТЗ и считаются в рабочих днях с момента получения предоплаты и
                всех необходимых материалов и доступов. Рабочее время — понедельник–пятница,
                10:00–20:00 МСК. Суббота, воскресенье и нерабочие праздничные дни являются
                выходными: сообщения можно прочитать и получить ответ, но работа в эти дни не
                выполняется.
              </p>
              <p>
                Обычный срок ответа — один рабочий день. Срочные задачи выполняются по отдельному
                согласованию и могут оплачиваться отдельно. Задержки со стороны Заказчика
                (материалы, доступы, правки, отсутствие обратной связи) продлевают сроки.
              </p>
            </section>

            <section
              id="demo"
              aria-labelledby="demo-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="demo-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                7. Демо-версия
              </h2>
              <p>
                По согласованию сторон Исполнитель может подготовить бесплатную демо-версию
                Результата. Демо предоставляется для ознакомления и оценки подхода, дизайна или
                функциональности.
              </p>
              <ul class="list-disc space-y-2 pl-5 marker:text-fg-dim">
                <li>Демо может иметь ограниченную функциональность и водяной знак.</li>
                <li>
                  Демо не содержит исходного кода и не предназначено для коммерческого
                  использования.
                </li>
                <li>
                  Демо остаётся собственностью Исполнителя; копировать, публиковать, декомпилировать
                  и передавать его третьим лицам нельзя.
                </li>
                <li>Срок доступа к демо может быть ограничен.</li>
              </ul>
              <p>
                После согласования демо Заказчик вносит 50% предоплату, и дальнейшая работа
                выполняется по смете и ТЗ. Итоговый Результат может отличаться от демо.
              </p>
            </section>

            <section
              id="acceptance"
              aria-labelledby="acceptance-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="acceptance-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                8. Приёмка работы
              </h2>
              <p>
                Исполнитель передаёт Заказчику демо, тестовый доступ или готовый Результат. Заказчик
                проверяет его в течение 5 рабочих дней и направляет мотивированные замечания одним
                списком со ссылкой на пункты ТЗ.
              </p>
              <p>
                Если в течение 5 рабочих дней мотивированные замечания не поступили, работа
                считается принятой. Подтверждением приёмки также является сообщение в Telegram, VK
                или по электронной почте; по желанию стороны могут подписать акт.
              </p>
              <ul class="list-disc space-y-2 pl-5 marker:text-fg-dim">
                <li>Замечания принимаются только по несоответствию ТЗ.</li>
                <li>
                  Вкусовые пожелания, новые функции и изменение концепции оформляются новой задачей
                  и сметой.
                </li>
                <li>
                  Критические ошибки, мешающие использованию Результата, исправляются бесплатно.
                </li>
                <li>Некритические доработки выполняются по согласованию сторон.</li>
              </ul>
              <p>
                После приёмки Заказчик оплачивает остаток 50%. До полной оплаты Исполнитель вправе
                не передавать исходный код, доступы и исключительные права. Если Заказчик не выходит
                на связь 30 календарных дней, проект может быть приостановлен; предоплата покрывает
                фактически выполненную работу.
              </p>
            </section>

            <section
              id="revisions"
              aria-labelledby="revisions-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="revisions-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                9. Правки и дополнительные работы
              </h2>
              <p>
                Если в смете не указано иное, в стоимость входит до двух кругов правок в рамках
                согласованного ТЗ. Заказчик направляет замечания одним списком, чтобы правки можно
                было выполнить последовательно и без потери сроков.
              </p>
              <p>
                Правки, выходящие за пределы ТЗ, новые функции, изменение структуры или дизайна
                оформляются отдельной задачей и сметой. Срочные правки выполняются по отдельному
                согласованию. После приёмки новые изменения также считаются отдельной работой.
              </p>
            </section>

            <section
              id="refund"
              aria-labelledby="refund-title"
              class="scroll-mt-24 space-y-4 break-inside-avoid"
            >
              <h2
                id="refund-title"
                class="text-xl font-semibold tracking-[-0.02em] text-fg sm:text-2xl"
              >
                10. Отказ от работы и возврат
              </h2>
              <p>
                Заказчик вправе отказаться от работы на любом этапе, направив письменное уведомление
                в Telegram, VK или по электронной почте. Возврат рассчитывается от суммы фактически
                полученной предоплаты, а не от общей стоимости заказа.
              </p>
              <div class="overflow-x-auto">
                <table class="w-full border-collapse text-sm">
                  <caption class="mb-3 text-left font-semibold text-fg">
                    Возврат предоплаты по этапам
                  </caption>
                  <thead>
                    <tr class="border-b border-line-strong text-left">
                      <th scope="col" class="px-3 py-2 font-semibold text-fg">
                        Готовность работы
                      </th>
                      <th scope="col" class="px-3 py-2 font-semibold text-fg">
                        Возврат от предоплаты
                      </th>
                      <th scope="col" class="px-3 py-2 font-semibold text-fg">
                        Комментарий
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-line align-top">
                      <td class="px-3 py-3">Работа не начата</td>
                      <td class="px-3 py-3 font-semibold text-fg">
                        100% минус фактические расходы
                      </td>
                      <td class="px-3 py-3">
                        Удерживаются только документально подтверждённые расходы.
                      </td>
                    </tr>
                    <tr class="border-b border-line align-top">
                      <td class="px-3 py-3">0–20%</td>
                      <td class="px-3 py-3 font-semibold text-fg">60%</td>
                      <td class="px-3 py-3">
                        Ранняя стадия: согласование, прототип, начало работы.
                      </td>
                    </tr>
                    <tr class="border-b border-line align-top">
                      <td class="px-3 py-3">21–70%</td>
                      <td class="px-3 py-3 font-semibold text-fg">50%</td>
                      <td class="px-3 py-3">
                        Середина работы: значительная часть Результата уже создана.
                      </td>
                    </tr>
                    <tr class="align-top">
                      <td class="px-3 py-3">71–100%</td>
                      <td class="px-3 py-3 font-semibold text-fg">0%</td>
                      <td class="px-3 py-3">
                        Поздняя стадия: стоимость работы и расходы равны предоплате или превышают
                        её.
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <p>
                Фактически понесённые расходы включают выполненную работу, оплату домена, хостинга,
                платных сервисов, комиссии и приобретённые ассеты. По запросу Исполнитель
                предоставляет расчёт. Возврат производится в течение 10 рабочих дней после
                согласования суммы.
              </p>
              <p>
                На поздней стадии (готовность более 70%) возврат не производится, поскольку
                стоимость выполненной работы и фактически понесённые расходы равны сумме предоплаты
                или превышают её. Исполнитель передаёт фактически готовый Результат после оплаты
                оставшейся части, если стороны не согласовали иное.
              </p>
              <p>
                Если от работы отказывается Исполнитель, он возвращает неиспользованную часть
                предоплаты. Настоящий раздел не ограничивает императивные права потребителя,
                установленные законодательством РФ; возврат определяется с учётом фактически
                понесённых расходов.
              </p>
            </section>

            <section
