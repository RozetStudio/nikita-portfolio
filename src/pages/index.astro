---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import Portfolio from "../components/sections/Portfolio";
import WhyMe from "../components/sections/WhyMe.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/layout/Footer.astro";

// TODO: описание для SEO и Open Graph — можно править
const description =
  "Фриланс-разработчик Никита: продающие лендинги, Telegram-боты, вёрстка из Figma и скрипты под задачу. Быстрый запуск, чистый код, поддержка.";
---

<BaseLayout title="Никита — лендинги, Telegram-боты, сайты и скрипты" description={description}>
  <Header />
  <main id="main">
    <Hero />
    <Services />
    <Process />
    <Portfolio client:visible />
    <WhyMe />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
