---
import BaseLayout from "../layouts/BaseLayout.astro";
import StarMark from "../components/ui/StarMark.astro";
---

<BaseLayout
  title="404 — страница не найдена | Никита"
  description="Такой страницы нет. Вернитесь на главную или напишите мне."
  noindex
>
  <main
    id="main"
    class="relative flex min-h-dvh flex-col items-center justify-center gap-6 px-5 text-center"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/[0.05] blur-[110px]"
    ></div>
    <div class="relative flex flex-col items-center gap-6" data-reveal>
      <span class="section-badge">
        <StarMark class="h-3 w-3 text-white/80" />
        Ошибка 404
      </span>
      <h1 class="text-[clamp(2.5rem,7vw,4.5rem)] font-semibold leading-none tracking-[-0.04em]">
        Такой страницы нет
      </h1>
      <p class="max-w-[420px] text-fg-muted">
        Возможно, ссылка устарела. Вернитесь на главную или напишите мне.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="/" class="btn btn-primary">
          На главную
        </a>
        <a href="/#contact" class="btn btn-outline">
          Написать
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
