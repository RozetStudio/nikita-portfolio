---
// Скрытая страница-заготовка для OG-картинки (1200×630).
// Скриншот этой страницы сохраняется в public/og.png и в прод не линкуется.
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=1200" />
    <title>OG — Никита</title>
    <style>
      @font-face {
        font-family: "Manrope Variable";
        src: url("/fonts/manrope-cyrillic-wght-normal.woff2") format("woff2-variations");
        font-weight: 200 800;
        font-display: block;
        unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }
      @font-face {
        font-family: "Manrope Variable";
        src: url("/fonts/manrope-latin-wght-normal.woff2") format("woff2-variations");
        font-weight: 200 800;
        font-display: block;
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
          U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Manrope Variable";
        src: url("/fonts/manrope-latin-ext-wght-normal.woff2") format("woff2-variations");
        font-weight: 200 800;
        font-display: block;
        unicode-range:
          U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329,
          U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113,
          U+2C60-2C7F, U+A720-A7FF;
      }
      html,
      body {
        margin: 0;
        background: #070707;
      }
      .stage {
        position: relative;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #070707;
        color: #f5f5f5;
        font-family: "Manrope Variable", Inter, "Segoe UI", system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .glow-1 {
        position: absolute;
        left: -140px;
        top: -180px;
        width: 640px;
        height: 460px;
        background: radial-gradient(closest-side, rgba(255, 255, 255, 0.14), transparent);
      }
      .glow-2 {
        position: absolute;
        right: -160px;
        top: -160px;
        width: 640px;
        height: 460px;
        background: radial-gradient(closest-side, rgba(255, 255, 255, 0.14), transparent);
      }
      .glow-3 {
        position: absolute;
        left: 300px;
        bottom: -260px;
        width: 600px;
        height: 420px;
        background: radial-gradient(closest-side, rgba(255, 255, 255, 0.08), transparent);
      }
      .beam {
        position: absolute;
        left: 599px;
        top: 0;
        width: 2px;
        height: 220px;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35), transparent);
      }
      .tile {
        position: relative;
        width: 96px;
        height: 96px;
        border-radius: 26px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: linear-gradient(145deg, #1c1c1c, #0a0a0a);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.12),
          0 0 60px rgba(255, 255, 255, 0.14),
          0 24px 60px -24px rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .tile svg {
        width: 40px;
        height: 40px;
        fill: #f5f5f5;
      }
      .name {
        position: relative;
        margin-top: 34px;
        font-size: 88px;
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1;
      }
      .role {
        position: relative;
        margin-top: 18px;
        font-size: 26px;
        font-weight: 500;
        color: #a3a3a3;
        letter-spacing: -0.01em;
      }
      .tag {
        position: relative;
        margin-top: 44px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 40px;
        padding: 0 22px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        font-size: 15px;
        font-weight: 600;
        color: #a3a3a3;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .tag span {
        width: 8px;
        height: 8px;
        fill: rgba(255, 255, 255, 0.8);
      }
    </style>
  </head>
  <body>
    <div class="stage">
      <div class="glow-1" aria-hidden="true"></div>
      <div class="glow-2" aria-hidden="true"></div>
      <div class="glow-3" aria-hidden="true"></div>
      <div class="beam" aria-hidden="true"></div>
      <div class="tile">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 4 C33.3 18 37.6 25.2 43.6 28.5 C49.6 31.8 56.3 32 62 32 C56.3 32 49.6 32.2 43.6 35.5 C37.6 38.8 33.3 46 32 60 C30.7 46 26.4 38.8 20.4 35.5 C14.4 32.2 7.7 32 2 32 C7.7 32 14.4 31.8 20.4 28.5 C26.4 25.2 30.7 18 32 4 Z"></path>
        </svg>
      </div>
      <div class="name">Никита</div>
      <div class="role">лендинги · Telegram-боты · вёрстка · скрипты</div>
      <div class="tag">
        <span>
          <svg viewBox="0 0 64 64">
            <path d="M32 4 C33.3 18 37.6 25.2 43.6 28.5 C49.6 31.8 56.3 32 62 32 C56.3 32 49.6 32.2 43.6 35.5 C37.6 38.8 33.3 46 32 60 C30.7 46 26.4 38.8 20.4 35.5 C14.4 32.2 7.7 32 2 32 C7.7 32 14.4 31.8 20.4 28.5 C26.4 25.2 30.7 18 32 4 Z"></path>
          </svg>
        </span>
        фриланс-разработчик
      </div>
    </div>
  </body>
</html>
