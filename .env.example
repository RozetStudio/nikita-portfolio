# =============================================================
# Скопируйте этот файл в .env и заполните значения.
# Файл .env не коммитится и не попадает в Docker-образ.
#
# ВАЖНО: сайт собирается как статика, значения читаются на этапе
# сборки. После изменения .env выполните:
#   docker compose up --build
# =============================================================

# Публичный адрес сайта.
# Включает canonical, абсолютные ссылки Open Graph и sitemap.
# Без значения canonical и sitemap не генерируются.
# Пример: https://nikita.example
PUBLIC_SITE_URL=

# Ссылка на Telegram-профиль. Пока не известна — оставьте пустой:
# кнопки покажут подсказку «Ссылка скоро появится».
# TODO: заполнить позже. Пример формата: https://t.me/username
TELEGRAM_URL=

# Ссылка на страницу VK. Пока не известна — оставьте пустой.
# TODO: заполнить позже. Пример формата: https://vk.com/username
VK_URL=

# Хост, на котором Docker публикует порты (compose, не Astro).
# 127.0.0.1 — только этот компьютер; 0.0.0.0 — доступ из локальной сети.
BIND_HOST=127.0.0.1
